{
  "name": "medusa-training-store",
  "version": "0.1.0",
  "description": "Medusa v2 commerce backend for selling online compliance & professional training courses.",
  "license": "MIT",
  "keywords": [
    "medusa",
    "medusajs",
    "ecommerce",
    "headless",
    "e-learning",
    "typescript"
  ],
  "scripts": {
    "build": "medusa build",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "start": "medusa start",
    "dev": "medusa develop",
    "db:migrate": "medusa db:migrate",
    "db:generate": "medusa db:generate training",
    "typecheck": "tsc --noEmit",
    "test:unit": "cross-env TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.21.1",
    "@medusajs/cli": "2.21.1",
    "@medusajs/framework": "2.21.1",
    "@medusajs/medusa": "2.21.1",
    "@medusajs/icons": "2.21.1",
    "@medusajs/ui": "4.2.5"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.21.1",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.14",
    "react-router-dom": "^7.18.2"
  },
  "engines": {
    "node": ">=20"
  }
}
