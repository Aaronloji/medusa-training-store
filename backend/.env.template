STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:3000
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=postgres://postgres:postgres@localhost:5432/medusa-training-store
# Set to "true" for managed Postgres that requires SSL (Neon, Supabase...)
DATABASE_SSL=false
# Optional: the seed creates this admin user (useful on hosts without a shell)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# "shared" (default) runs HTTP and background work in one process;
# use "server" + "worker" to split them (see docker-compose.production.yml)
MEDUSA_WORKER_MODE=shared
# Certificate emails: without an API key they are logged instead of sent
RESEND_API_KEY=
RESEND_FROM=
STOREFRONT_URL=http://localhost:3000
